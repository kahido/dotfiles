[user]
    name = kahido
    email = 66074309+kahido@users.noreply.github.com

[core]
    compression = 9
    whitespace = error
    preloadindex = true
    editor = nvim

[advice]
    addEmptyPathspec = false
    pushNonFastForward = false
    statusHints = false

[status]
    branch = true
    showStash = true
    showUntrackedFiles = all

[diff]
    context = 3
    renames = copies
    interHunkContext = 10

[color "diff"]
    meta       = black bold
    frag       = magenta
    context    = white
    whitespace = yellow reverse
    old        = red

[interactive]
    singlekey = true

[commit]
    verbose = true

[push]
    autoSetupRemote = true
    default = current

[pull]
    default = current
    rebase = true

[rebase]
    autoStash = true
    missingCommitsCheck = warn

[log]
    abbrevCommit = true
    graphColors  = blue,yellow,cyan,magenta,green,red

[color "decaorate"]
    HEAD = red
    branch = blis
    tag = yellow
    remoteBranch = magenta

[color "branch"]
    current  = magenta
    local    = default
    remote   = yellow
    upstream = green
    plain    = blue

[branch]
    sort = -committerdate

[tag]
    sort = -taggerdate

[pager]
    branch = false
    tag = false
